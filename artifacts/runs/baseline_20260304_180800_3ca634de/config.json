{
  "pipeline": "run_baseline",
  "params": {
    "data": "data/processed/genius_processed.csv",
    "eval_config": "configs/eval.yaml",
    "retrieval_config": "configs/retrieval.yaml",
    "emotion_config": "configs/emotion_context.yaml",
    "seed": 42,
    "save_vectors_csv": false,
    "include_intensity": false,
    "include_vad": false,
    "n_queries": 0,
    "top_m": 0,
    "top_k": 0,
    "mmr_lambda": -1.0,
    "disable_mmr": false
  },
  "merged_cfg": {
    "eval": {
      "seed": 42,
      "n_queries": 300,
      "k_values": [
        5,
        10,
        20
      ],
      "query_sampling": {
        "stratify_by": [
          "genre"
        ],
        "min_per_stratum": 10
      }
    },
    "pseudo_ground_truth": {
      "year_window": 10,
      "require_same_genre": true,
      "exclude_same_song": true,
      "exclude_same_artist": true,
      "graded_relevance": {
        "enabled": true,
        "grade_if_same_genre_and_within_year": 2,
        "grade_if_same_genre_only": 0,
        "max_grade1_per_query": 0
      }
    },
    "metrics": {
      "recall": {
        "enabled": true
      },
      "ndcg": {
        "enabled": true
      },
      "emotion_consistency": {
        "enabled": true,
        "representation": "emotion_ratio",
        "similarity": "cosine",
        "threshold": null
      },
      "ild": {
        "enabled": true,
        "distance": "1-cosine"
      }
    },
    "outputs": {
      "song_vector_name": "emotion_context_vectors",
      "line_feature_name": "emotion_context_line_features"
    },
    "index": {
      "backend": "chroma",
      "persist_dir": "artifacts/indexes/chroma",
      "collection_name": "lyrics_reco",
      "metric": "cosine",
      "rebuild": false
    },
    "retrieval": {
      "similarity": "cosine",
      "top_m": 200,
      "top_k": 20,
      "mmr": {
        "enabled": true,
        "lambda": 0.7,
        "similarity": "cosine",
        "min_candidates": 50
      }
    },
    "filters": {
      "exclude_same_song": true,
      "exclude_same_artist": false,
      "year_window": null
    },
    "embedder": {
      "model_name": "sentence-transformers/all-MiniLM-L6-v2",
      "device": "auto",
      "batch_size": 64,
      "normalize_embeddings": true,
      "max_length": 256
    },
    "text": {
      "line_split": "newline",
      "keep_original_for_lexicon": true,
      "dedup_for_embedding": true,
      "strip_brackets": true,
      "min_line_chars": 3,
      "max_lines_per_song": 250
    },
    "emotion": {
      "emotions": [
        "anger",
        "fear",
        "joy",
        "sadness",
        "disgust",
        "trust"
      ],
      "nrc_lexicon_file": "assets/lexicons/nrc_lexicon.txt"
    },
    "intensity": {
      "enabled": true,
      "nrc_intensity_file": "assets/lexicons/nrc_intensity.txt",
      "aggregation": "mean",
      "clamp_min": 0.0,
      "clamp_max": 1.0
    },
    "vad": {
      "enabled": true,
      "vad_lexicon_file": "assets/lexicons/vad_lexicon.txt",
      "aggregation": "mean",
      "clamp_min": -1.0,
      "clamp_max": 1.0
    },
    "line_weighting": {
      "alpha_emotion": 1.0,
      "beta_intensity": 1.0,
      "gamma_arousal": 1.0,
      "normalize": "softmax",
      "softmax_temperature": 1.0
    },
    "aggregation": {
      "method": "weighted_mean",
      "min_emotion_word_count": 1
    }
  }
}